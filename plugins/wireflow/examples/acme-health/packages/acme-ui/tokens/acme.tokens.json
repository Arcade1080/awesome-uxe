{
  "color": {
    "$type": "color",
    "action": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.043, 0.431, 0.475], "hex": "#0b6e79" } },
      "primary-subtle": { "$value": { "colorSpace": "srgb", "components": [0.902, 0.949, 0.953], "hex": "#e6f2f3" } },
      "on-primary": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
    },
    "text": {
      "default": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.102, 0.11], "hex": "#0f1a1c" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.357, 0.42, 0.439], "hex": "#5b6b70" } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.486, 0.541, 0.557], "hex": "#7c8a8e" } }
    },
    "surface": {
      "default": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.957, 0.969, 0.973], "hex": "#f4f7f8" } }
    },
    "border": {
      "default": { "$value": { "colorSpace": "srgb", "components": [0.788, 0.831, 0.839], "hex": "#c9d4d6" } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.882, 0.91, 0.918], "hex": "#e1e8ea" } }
    },
    "feedback": {
      "success": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.478, 0.302], "hex": "#1f7a4d" } },
      "success-subtle": { "$value": { "colorSpace": "srgb", "components": [0.906, 0.961, 0.933], "hex": "#e7f5ee" } },
      "danger": { "$value": { "colorSpace": "srgb", "components": [0.706, 0.137, 0.094], "hex": "#b42318" } },
      "danger-subtle": { "$value": { "colorSpace": "srgb", "components": [0.992, 0.925, 0.918], "hex": "#fdecea" } },
      "info": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.435, 0.698], "hex": "#1f6fb2" } },
      "info-subtle": { "$value": { "colorSpace": "srgb", "components": [0.933, 0.965, 0.992], "hex": "#eef6fd" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 10, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "family": { "base": { "$type": "fontFamily", "$value": ["Figtree", "Inter", "system-ui", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "label": { "$value": { "value": 13, "unit": "px" } },
      "body": { "$value": { "value": 15, "unit": "px" } },
      "heading": { "$value": { "value": 17, "unit": "px" } },
      "title": { "$value": { "value": 22, "unit": "px" } }
    }
  }
}
